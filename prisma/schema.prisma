datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}



model Product {
  id String @id @default(cuid())
  name String
  price Float
  category String
  stock Int @default(100)
  imageId String? @unique
  image ProductImage? @relation(fields: [imageId], references: [id])
  createdAt DateTime @default(now())
}

model ProductImage {
  id String @id @default(cuid())
  data String
  product Product?
  createdAt DateTime @default(now())
}

model Sale {
  id String @id @default(cuid())
  total Float
  items String
  createdAt DateTime @default(now())
}